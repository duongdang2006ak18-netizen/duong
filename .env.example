# Start-Store.ps1 creates a private .env with generated encryption keys and
# a one-way admin password hash. Do not use this example as production config.
PORT=3000
ACCOUNT_ENCRYPTION_KEY=generate-a-unique-64-character-hex-key
ADMIN_USERNAME_B64=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=
BANK_CODE=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME_B64=
# Set NODE_ENV=production behind HTTPS. Set TRUST_PROXY=1 only behind a trusted proxy.
